// ============================================================================
// Firestore Security Rules — EduForEveryone (project: eduforeveryone-ded2d)
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'Vbw90jysj8c4X4R02sPmdNKjvrf2';
    }

    function isValidGameId(gameId) {
      return gameId in [
        'global',
        'islamic-quiz',
        'math-puzzle',
        'word-puzzle',
        'quiz-battle',
        'quran-words',
        'subject-quiz'
      ];
    }

    function todayUtcString() {
      let y = string(request.time.year());
      let m = request.time.month() < 10 ? '0' + string(request.time.month()) : string(request.time.month());
      let d = request.time.day() < 10 ? '0' + string(request.time.day()) : string(request.time.day());
      return y + '-' + m + '-' + d;
    }

    function dailyCapForGame(gameId) {
      return gameId == 'global' ? 3000 : 500;
    }

    function hasValidLeaderboardEntryShape(gameId, uid) {
      let d = request.resource.data;
      return isValidGameId(gameId)
        && isOwner(uid)
        && d.keys().hasOnly([
          'uid',
          'displayName',
          'photoURL',
          'totalPoints',
          'bestRound',
          'games',
          'dailyPoints',
          'dailyDate',
          'updatedAt'
        ])
        && d.keys().hasAll([
          'uid',
          'displayName',
          'photoURL',
          'totalPoints',
          'bestRound',
          'games',
          'dailyPoints',
          'dailyDate',
          'updatedAt'
        ])
        && d.uid == uid
        && d.displayName is string
        && d.displayName.size() >= 1 && d.displayName.size() <= 100
        && d.photoURL is string
        && d.totalPoints is number && d.totalPoints >= 0
        && d.bestRound is number && d.bestRound >= 0 && d.bestRound <= 270
        && d.games is number && d.games >= 1
        && d.dailyPoints is number && d.dailyPoints >= 0 && d.dailyPoints <= dailyCapForGame(gameId)
        && d.dailyDate is string && d.dailyDate == todayUtcString()
        && (d.updatedAt is timestamp || d.updatedAt is number);
    }

    function isValidLeaderboardEntryCreate(gameId, uid) {
      let d = request.resource.data;
      return hasValidLeaderboardEntryShape(gameId, uid)
        && d.games == 1
        && d.totalPoints == d.dailyPoints
        && d.dailyPoints <= 270
        && d.bestRound >= d.dailyPoints;
    }

    function isValidLeaderboardEntryUpdate(gameId, uid) {
      let d = request.resource.data;
      let prev = resource.data;
      let totalDelta = d.totalPoints - prev.totalPoints;
      let dailyDelta = d.dailyPoints - prev.dailyPoints;
      return hasValidLeaderboardEntryShape(gameId, uid)
        && d.games == prev.games + 1
        && d.bestRound >= prev.bestRound
        && totalDelta >= 0 && totalDelta <= 270
        && (
          (prev.dailyDate == todayUtcString() && dailyDelta == totalDelta)
          || (prev.dailyDate != todayUtcString() && d.dailyPoints == totalDelta)
        );
    }

    // ── 1. Users & Subcollections (including courseProgress) ────────────────
    // users/{uid} and any subcollections: only the signed-in owner can read & write.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /courseProgress/{topicId} {
        allow read, write: if isOwner(uid);
      }

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── 2. Unified Leaderboards (leaderboards/{gameId}/entries/{uid}) ───────
    match /leaderboards/{gameId}/entries/{uid} {
      allow read: if isValidGameId(gameId);
      allow create: if isValidLeaderboardEntryCreate(gameId, uid);
      allow update: if isValidLeaderboardEntryUpdate(gameId, uid);
      allow delete: if isValidGameId(gameId) && isOwner(uid);
    }

    // ── 2b. Legacy Leaderboards (Read-Only) ─────────────────────────────────
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_quran/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_hadith/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_fiqh/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_seerah/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_history/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_pillars/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard_names/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ── 3. Quiz Sessions (quizSessions/{sessionId}) ─────────────────────────
    // Written by saveQuizScore / saveGameScore: { uid, displayName, photoURL,
    // gameName, category, difficulty, score, correct, total, playedAt }
    match /quizSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.gameName is string
        && request.resource.data.category is string
        && request.resource.data.difficulty is string
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000
        && request.resource.data.correct is number
        && request.resource.data.total is number
        && request.resource.data.correct >= 0
        && request.resource.data.correct <= request.resource.data.total;
      allow update, delete: if false;
    }

    // ── 4. IELTS & GMAT User History ────────────────────────────────────────
    // Written by saveIeltsResult: { uid, displayName, skill, band, raw, total,
    // testId, source, mockId, date }
    match /ieltsSessions/{sessionId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.skill in ['listening', 'reading', 'writing', 'speaking']
        && request.resource.data.source in ['practice', 'simulation', 'full-mock']
        && request.resource.data.band is number
        && request.resource.data.band >= 0
        && request.resource.data.band <= 9;
      allow update, delete: if false;
    }

    // Written by saveGmatResult: { formId, sections, estimatedTotal, completedAt }
    match /gmatResults/{uid}/sessions/{sessionId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.formId is string
        && request.resource.data.sections is list
        && request.resource.data.estimatedTotal is number;
      allow update, delete: if false;
    }

    // ── 5. Admin Content Collections (Public Read, Admin Write Only) ────────
    // Shown to all visitors on public pages; writes restricted to isAdmin().
    match /admin_ielts_listening/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_ielts_reading/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_math/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_quiz/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_courses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_notes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 6. Admin Audit Log (admin_uploads) ──────────────────────────────────
    // Only read/written inside AdminPanel.tsx — NOT shown to public visitors.
    match /admin_uploads/{docId} {
      allow read, write: if isAdmin();
    }

    // ── 7. Default Deny Everything Else ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
