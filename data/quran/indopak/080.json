{
 "surah": 80,
 "edition": "qul-indopak-nastaleeq-hanafi",
 "attribution": "IndoPak Nastaleeq Quran text (Hanafi) and the font \"AlQuran IndoPak by QuranWBW\" (v2.100) by QuranWBW.com (Ayman Siddiqui, R. Siddiqua), obtained from the Quranic Universal Library (qul.tarteel.ai/resources/quran-script/59). Made for Sadaqa-e-Jaria. Do not sell, modify or tamper with this text, and always give credit.",
 "ayahs": [
  {
   "n": 1,
   "text": "عَبَسَ وَتَوَلّٰۤی ۟ۙ"
  },
  {
   "n": 2,
   "text": "اَنْ جَآءَهُ الْاَعْمٰى ۟ؕ"
  },
  {
   "n": 3,
   "text": "وَمَا یُدْرِیْكَ لَعَلَّهٗ یَزَّ ۟ۙ"
  },
  {
   "n": 4,
   "text": "اَوْ یَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰى ۟ؕ"
  },
  {
   "n": 5,
   "text": "اَمَّا مَنِ اسْتَغْنٰى ۟ۙ"
  },
  {
   "n": 6,
   "text": "فَاَنْتَ لَهٗ تَصَدّٰى ۟ؕ"
  },
  {
   "n": 7,
   "text": "وَمَا عَلَیْكَ اَلَّا یَزَّكّٰى ۟ؕ"
  },
  {
   "n": 8,
   "text": "وَاَمَّا مَنْ جَآءَكَ یَسْعٰى ۟ۙ"
  },
  {
   "n": 9,
   "text": "وَهُوَ یَخْشٰى ۟ۙ"
  },
  {
   "n": 10,
   "text": "فَاَنْتَ عَنْهُ تَلَهّٰى ۟ۚ"
  },
  {
   "n": 11,
   "text": "كَلَّاۤ اِنَّهَا تَذْكِرَةٌ ۟ۚ"
  },
  {
   "n": 12,
   "text": "فَمَنْ شَآءَ ذَكَرَهٗ ۟ۘ"
  },
  {
   "n": 13,
   "text": "فِیْ صُحُفٍ مُّكَرَّمَةٍ ۟ۙ"
  },
  {
   "n": 14,
   "text": "مَّرْفُوْعَةٍ مُّطَهَّرَةٍۭ ۟ۙ"
  },
  {
   "n": 15,
   "text": "بِاَیْدِیْ سَفَرَةٍ ۟ۙ"
  },
  {
   "n": 16,
   "text": "كِرَامٍ بَرَرَةٍ ۟ؕ"
  },
  {
   "n": 17,
   "text": "قُتِلَ الْاِنْسَانُ مَاۤ اَكْفَرَهٗ ۟ؕ"
  },
  {
   "n": 18,
   "text": "مِنْ اَیِّ شَیْءٍ خَلَقَهٗ ۟ؕ"
  },
  {
   "n": 19,
   "text": "مِنْ نُّطْفَةٍ ؕ خَلَقَهٗ فَقَدَّرَهٗ ۟ۙ"
  },
  {
   "n": 20,
   "text": "ثُمَّ السَّبِیْلَ یَسَّرَهٗ ۟ۙ"
  },
  {
   "n": 21,
   "text": "ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۟ۙ"
  },
  {
   "n": 22,
   "text": "ثُمَّ اِذَا شَآءَ اَنْشَرَهٗ ۟ؕ"
  },
  {
   "n": 23,
   "text": "كَلَّا لَمَّا یَقْضِ مَاۤ اَمَرَهٗ ۟ؕ"
  },
  {
   "n": 24,
   "text": "فَلْیَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖۤ ۟ۙ"
  },
  {
   "n": 25,
   "text": "اَنَّا صَبَبْنَا الْمَآءَ صَبًّا ۟ۙ"
  },
  {
   "n": 26,
   "text": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۟ۙ"
  },
  {
   "n": 27,
   "text": "فَاَنْۢبَتْنَا فِیْهَا حَبًّا ۟ۙ"
  },
  {
   "n": 28,
   "text": "وَّعِنَبًا وَّقَضْبًا ۟ۙ"
  },
  {
   "n": 29,
   "text": "وَّزَیْتُوْنًا وَّنَخْلًا ۟ۙ"
  },
  {
   "n": 30,
   "text": "وَّحَدَآىِٕقَ غُلْبًا ۟ۙ"
  },
  {
   "n": 31,
   "text": "وَّفَاكِهَةً وَّاَبًّا ۟ۙ"
  },
  {
   "n": 32,
   "text": "مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۟ؕ"
  },
  {
   "n": 33,
   "text": "فَاِذَا جَآءَتِ الصَّآخَّةُ ۟ؗ"
  },
  {
   "n": 34,
   "text": "یَوْمَ یَفِرُّ الْمَرْءُ مِنْ اَخِیْهِ ۟ۙ"
  },
  {
   "n": 35,
   "text": "وَاُمِّهٖ وَاَبِیْهِ ۟ۙ"
  },
  {
   "n": 36,
   "text": "وَصَاحِبَتِهٖ وَبَنِیْهِ ۟ؕ"
  },
  {
   "n": 37,
   "text": "لِكُلِّ امْرِئٍ مِّنْهُمْ یَوْمَىِٕذٍ شَاْنٌ یُّغْنِیْهِ ۟ؕ"
  },
  {
   "n": 38,
   "text": "وُجُوْهٌ یَّوْمَىِٕذٍ مُّسْفِرَةٌ ۟ۙ"
  },
  {
   "n": 39,
   "text": "ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۟ۚ"
  },
  {
   "n": 40,
   "text": "وَوُجُوْهٌ یَّوْمَىِٕذٍ عَلَیْهَا غَبَرَةٌ ۟ۙ"
  },
  {
   "n": 41,
   "text": "تَرْهَقُهَا قَتَرَةٌ ۟ؕ"
  },
  {
   "n": 42,
   "text": "اُولٰٓىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ۟۠"
  }
 ]
}
