{"surah":111,"attribution":"Indo-Pak text: \"Indopak Nastaleeq script\", Quranic Universal Library (qul.tarteel.ai/resources/quran-script/89), unchanged. Font: AlQuran IndoPak by QuranWBW. Tajweed rule positions copied from QUL \"QPC Hafs Script - With Tajweed\" (resource 58).","ayahs":[{"n":1,"text":"تَبَّتْ یَدَاۤ اَبِیْ لَهَبٍ وَّتَبَّ ۟ؕ","runs":[["تَبَّتْ یَ"],["دَاۤ",7],[" اَبِیْ لَهَ"],["بٍ",11],[" "],["وَّ",11],["تَ"],["بَّ",8],[" ۟ؕ"]]},{"n":2,"text":"مَاۤ اَغْنٰی عَنْهُ مَالُهٗ وَمَا كَسَبَ ۟ؕ","runs":[["مَاۤ",7],[" اَغْنٰی عَنْهُ مَالُه"],["ٗ",3],[" وَمَا كَسَ"],["بَ",8],[" ۟ؕ"]]},{"n":3,"text":"سَیَصْلٰی نَارًا ذَاتَ لَهَبٍ ۟ۚۖ","runs":[["سَیَصْلٰی نَا"],["رًا",9],[" "],["ذَ",9],["اتَ لَهَ"],["بٍ",8],[" ۟ۚۖ"]]},{"n":4,"text":"وَّامْرَاَتُهٗ ؕ حَمَّالَةَ الْحَطَبِ ۟ۚ","runs":[["وَّ"],["ا",0],["مْرَاَتُه"],["ٗ",3],[" ؕ حَ"],["مَّ",17],["الَةَ "],["ا",0],["لْحَطَ"],["بِ",8],[" ۟ۚ"]]},{"n":5,"text":"فِیْ جِیْدِهَا حَبْلٌ مِّنْ مَّسَدٍ ۟۠","runs":[["فِیْ جِیْدِهَا حَ"],["بْ",8],["لٌ",11],[" "],["مِّنْ",11],[" "],["مَّ",11],["سَ"],["دٍ",8],[" ۟۠"]]}]}
